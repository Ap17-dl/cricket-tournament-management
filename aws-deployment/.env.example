# ==============================================================================
# Cricket Tournament Management Platform - Environment Variables Template
# ==============================================================================
# IMPORTANT: Never commit actual secrets or production keys to version control.
# Copy this file to .env.local for local development, or supply these variables
# during deployment via your CI/CD pipeline or AWS Secrets Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Exposed to Vite frontend bundle)
# ------------------------------------------------------------------------------
# The HTTPS URL of your Supabase project instance
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# The public/anonymous API key (safe for browser usage; secured by Supabase RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Database & Administrative Configuration (SERVER ONLY - NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# PostgreSQL direct connection URI (used for executing backend_schema SQL migrations)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
VITE_POSTGRESQL_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Supabase Service Role Secret Key (used only for admin scripts & Edge Functions)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Supabase Auth JWKS endpoint for validating JWT tokens
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Resend API Key for sending career application notification emails
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 3. AWS Infrastructure Deployment Parameters (Used by deploy scripts)
# ------------------------------------------------------------------------------
# Target AWS Region (e.g. ap-south-1, us-east-1, eu-west-1)
AWS_REGION=ap-south-1

# CloudFormation Stack Name
STACK_NAME=cricket-tournament-demo

# Optional: Email address to subscribe to CloudWatch 5xx alarm notifications
ALERT_EMAIL=
